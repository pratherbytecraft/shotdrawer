{
  "name": "shotdrawer",
  "version": "0.1.0",
  "description": "A menu bar app for macOS that lists your recent screenshots and copies their paths with one click.",
  "author": "Prather Bytecraft",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "homepage": "https://github.com/pratherbytecraft/shotdrawer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratherbytecraft/shotdrawer.git"
  },
  "bugs": {
    "url": "https://github.com/pratherbytecraft/shotdrawer/issues"
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/main/index.js",
  "bin": {
    "shotdrawer": "dist/bin/shotdrawer.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "npm run build && node dist/bin/shotdrawer.js --foreground",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p . && tsc -p src/renderer && tsc -p test/cypress",
    "prepack": "npm run typecheck && npm run build",
    "postinstall": "node dist/scripts/fix-electron.js && node dist/scripts/build-app.js",
    "build-app": "node dist/scripts/build-app.js",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:pages": "npm run build && cypress run --config-file test/cypress/cypress.config.ts"
  },
  "dependencies": {
    "electron": "^33.2.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "cypress": "14.5.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
